# 复制本文件为 backend/.env 后按需修改（.env 不会提交到 Git）

# ---------- 默认：SQLite（与 DataGrip 打开 backend/smart_route.db 为同一文件）----------
DATABASE_URL=sqlite:///./smart_route.db

# ---------- 本机 MySQL：先建库、执行 docs/schema.sql 与 V1.2 变更，再 pip install pymysql ----------
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/smart_route

# ---------- 高德 Web 服务（手动补算里程/时效、门店相似检索；勿将真实 Key 提交 Git）----------
# AMAP_KEY=
# AMAP_SECURITY_KEY=
# 已配置 AMAP_KEY 时默认走真实接口；仅本地想强制模拟时：GAODE_MOCK_ENABLED=true
# GAODE_MOCK_ENABLED=true
